# Copy to .env; never commit real secrets.
HOST=127.0.0.1
PORT=8080
DATA_DIR=.data
PUBLIC_SITE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
LIVE_COLLECTION=0
POLL_SECONDS=120
ALLOW_REFERENCE_FALLBACK=0
CAPTURE_POSTS=0
TRANSLATE_POSTS=0

# Optional AI mode (enables live collection and original X screenshots).
# Install Codex CLI and log in as the OS user that runs this project.
AI_ANALYSIS=0
CODEX_EXECUTABLE=codex
CODEX_MODEL=gpt-6-astra
AI_MAX_JOBS=3
AI_TIMEOUT_SECONDS=150
AI_BUDGET_SECONDS=240
# Browser capture needs an explicit proxy if direct X access is unavailable.
# urllib discovery and Codex may separately use HTTPS_PROXY / HTTP_PROXY.
CAPTURE_PROXY=
CAPTURE_PROXY_USERNAME=
CAPTURE_PROXY_PASSWORD=
